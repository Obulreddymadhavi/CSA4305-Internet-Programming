<!DOCTYPE html>
<html lang="en">

<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>BlossomGifts - Flowers & Gifts</title>

<style>

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

body {
    background: #fff7fa;
    color: #333;
}

/* HEADER */

header {
    background: #8e2450;
    color: white;
    padding: 18px 7%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: sticky;
    top: 0;
    z-index: 1000;
}

.logo {
    font-size: 28px;
    font-weight: bold;
}

.logo span {
    color: #ffd1e1;
}

nav a {
    color: white;
    text-decoration: none;
    margin: 0 10px;
    cursor: pointer;
}

nav a:hover {
    color: #ffd1e1;
}

.cart-btn {
    background: #ffd1e1;
    color: #8e2450;
    border: none;
    padding: 10px 16px;
    border-radius: 5px;
    cursor: pointer;
    font-weight: bold;
}

/* HERO */

.hero {
    min-height: 430px;
    background: linear-gradient(
        rgba(142,36,80,0.75),
        rgba(142,36,80,0.75)
    ),
    url("https://images.unsplash.com/photo-1490750967868-88aa4486c946")
    center/cover;

    display: flex;
    align-items: center;
    padding: 60px 8%;
    color: white;
}

.hero-content {
    max-width: 650px;
}

.hero h1 {
    font-size: 48px;
    margin-bottom: 20px;
}

.hero p {
    font-size: 19px;
    line-height: 1.6;
    margin-bottom: 25px;
}

.btn {
    padding: 13px 25px;
    border: none;
    background: #ffd1e1;
    color: #8e2450;
    font-weight: bold;
    border-radius: 6px;
    cursor: pointer;
}

.btn:hover {
    opacity: 0.9;
}

/* SECTIONS */

.section {
    padding: 50px 7%;
}

.section h2 {
    text-align: center;
    color: #8e2450;
    font-size: 30px;
    margin-bottom: 30px;
}

/* CATEGORIES */

.categories {
    display: grid;
    grid-template-columns:
    repeat(auto-fit, minmax(180px, 1fr));

    gap: 20px;
}

.category {
    background: white;
    padding: 25px;
    text-align: center;
    border-radius: 10px;

    box-shadow:
    0 3px 12px rgba(0,0,0,0.1);

    cursor: pointer;
}

.category:hover {
    transform: translateY(-5px);
}

.category .icon {
    font-size: 50px;
}

.category h3 {
    margin-top: 12px;
    color: #8e2450;
}

/* SEARCH */

.search-area {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-bottom: 30px;
}

.search-area input,
.search-area select {

    padding: 12px;

    border: 1px solid #ccc;

    border-radius: 5px;
}

.search-area input {
    width: 350px;
}

/* PRODUCTS */

.products {

    display: grid;

    grid-template-columns:
    repeat(auto-fit, minmax(220px, 1fr));

    gap: 25px;
}

.product {

    background: white;

    border-radius: 10px;

    overflow: hidden;

    box-shadow:
    0 3px 12px rgba(0,0,0,0.1);
}

.product img {

    width: 100%;

    height: 250px;

    object-fit: cover;
}

.product-info {

    padding: 18px;
}

.product-info h3 {

    color: #8e2450;

    margin-bottom: 8px;
}

.price {

    color: #8e2450;

    font-size: 20px;

    font-weight: bold;

    margin: 10px 0;
}

.product button {

    width: 100%;

    padding: 11px;

    border: none;

    background: #8e2450;

    color: white;

    border-radius: 5px;

    cursor: pointer;
}

/* CART */

.cart {

    position: fixed;

    right: -420px;

    top: 0;

    width: 400px;

    height: 100%;

    background: white;

    padding: 25px;

    z-index: 2000;

    box-shadow:
    -3px 0 12px rgba(0,0,0,0.2);

    transition: 0.3s;

    overflow-y: auto;
}

.cart.active {
    right: 0;
}

.close-cart {

    float: right;

    border: none;

    background: none;

    font-size: 28px;

    cursor: pointer;
}

.cart-item {

    display: flex;

    justify-content: space-between;

    padding: 15px 0;

    border-bottom: 1px solid #ddd;
}

.cart-total {

    font-size: 20px;

    font-weight: bold;

    margin: 20px 0;
}

/* ORDER */

.order-section {

    background: white;

    max-width: 700px;

    margin: auto;

    padding: 30px;

    border-radius: 10px;

    box-shadow:
    0 3px 12px rgba(0,0,0,0.1);
}

.order-section input,
.order-section select {

    width: 100%;

    padding: 12px;

    margin: 8px 0 15px;

    border: 1px solid #ccc;

    border-radius: 5px;
}

/* ADMIN */

.admin-panel {

    display: grid;

    grid-template-columns:
    repeat(auto-fit, minmax(200px, 1fr));

    gap: 20px;
}

.admin-card {

    background: white;

    padding: 25px;

    border-left: 5px solid #8e2450;

    box-shadow:
    0 3px 10px rgba(0,0,0,0.1);
}

.admin-card h3 {

    color: #8e2450;

    margin-bottom: 10px;
}

/* LOGIN MODAL */

.modal {

    display: none;

    position: fixed;

    left: 0;

    top: 0;

    width: 100%;

    height: 100%;

    background: rgba(0,0,0,0.6);

    z-index: 3000;
}

.modal-content {

    background: white;

    width: 380px;

    max-width: 90%;

    margin: 100px auto;

    padding: 30px;

    border-radius: 10px;
}

.modal-content h2 {

    text-align: center;

    color: #8e2450;

    margin-bottom: 20px;
}

.modal-content input,
.modal-content select {

    width: 100%;

    padding: 12px;

    margin: 8px 0;

    border: 1px solid #ccc;

    border-radius: 5px;
}

.modal-content button {

    width: 100%;

    margin-top: 10px;
}

.close {

    float: right;

    font-size: 25px;

    cursor: pointer;
}

/* FOOTER */

footer {

    background: #681b3b;

    color: white;

    text-align: center;

    padding: 30px;

    margin-top: 40px;
}

/* MOBILE */

@media(max-width:700px) {

    header {

        flex-direction: column;

        gap: 15px;
    }

    .hero h1 {

        font-size: 35px;
    }

    .search-area {

        flex-direction: column;
    }

    .search-area input {

        width: 100%;
    }

    .cart {

        width: 100%;
    }
}

</style>
</head>


<body>


<!-- HEADER -->

<header>

    <div class="logo">
        Blossom<span>Gifts</span>
    </div>

    <nav>

        <a href="#home">Home</a>

        <a href="#categories">
            Categories
        </a>

        <a href="#products">
            Products
        </a>

        <a href="#orders">
            Orders
        </a>

        <a onclick="openLogin()">
            Login
        </a>

    </nav>

    <button class="cart-btn"
            onclick="openCart()">

        🛒 Cart
        (<span id="cartCount">0</span>)

    </button>

</header>


<!-- HERO -->

<section class="hero" id="home">

    <div class="hero-content">

        <h1>
            Send Love With Flowers & Gifts
        </h1>

        <p>

            Beautiful flowers and thoughtful gifts
            for every special occasion.

        </p>

        <button class="btn"
                onclick="document
                .getElementById('products')
                .scrollIntoView()">

            Shop Now

        </button>

    </div>

</section>


<!-- CATEGORIES -->

<section class="section"
         id="categories">

    <h2>
        Shop By Category
    </h2>

    <div class="categories">


        <div class="category"
             onclick="filterCategory('Flowers')">

            <div class="icon">
                🌹
            </div>

            <h3>
                Flowers
            </h3>

            <p>
                Fresh floral arrangements
            </p>

        </div>


        <div class="category"
             onclick="filterCategory('Gift Baskets')">

            <div class="icon">
                🎁
            </div>

            <h3>
                Gift Baskets
            </h3>

            <p>
                Special gift collections
            </p>

        </div>


        <div class="category"
             onclick="filterCategory('Personalized')">

            <div class="icon">
                💝
            </div>

            <h3>
                Personalized Gifts
            </h3>

            <p>
                Customized gifts
            </p>

        </div>


        <div class="category"
             onclick="filterCategory('Birthday')">

            <div class="icon">
                🎂
            </div>

            <h3>
                Birthday
            </h3>

            <p>
                Birthday surprises
            </p>

        </div>


        <div class="category"
             onclick="filterCategory('Anniversary')">

            <div class="icon">
                💐
            </div>

            <h3>
                Anniversary
            </h3>

            <p>
                Romantic gifts
            </p>

        </div>

    </div>

</section>


<!-- PRODUCTS -->

<section class="section"
         id="products">

    <h2>
        Our Products
    </h2>


    <div class="search-area">

        <input
            type="text"
            id="search"
            placeholder="Search flowers or gifts..."
            onkeyup="searchProducts()">


        <select
            id="categoryFilter"
            onchange="filterProducts()">

            <option value="All">
                All Categories
            </option>

            <option value="Flowers">
                Flowers
            </option>

            <option value="Gift Baskets">
                Gift Baskets
            </option>

            <option value="Personalized">
                Personalized
            </option>

            <option value="Birthday">
                Birthday
            </option>

            <option value="Anniversary">
                Anniversary
            </option>

        </select>

    </div>


    <div class="products"
         id="productList">

    </div>

</section>


<!-- ORDER SECTION -->

<section class="section"
         id="orders">

    <h2>
        Schedule Your Delivery
    </h2>

    <div class="order-section">

        <label>
            Customer Name
        </label>

        <input
            type="text"
            id="customerName"
            placeholder="Enter your name">


        <label>
            Delivery Date
        </label>

        <input
            type="date"
            id="deliveryDate">


        <label>
            Delivery Time
        </label>

        <select id="deliveryTime">

            <option>
                9:00 AM - 12:00 PM
            </option>

            <option>
                12:00 PM - 3:00 PM
            </option>

            <option>
                3:00 PM - 6:00 PM
            </option>

            <option>
                6:00 PM - 9:00 PM
            </option>

        </select>


        <label>
            Delivery Address
        </label>

        <input
            type="text"
            id="address"
            placeholder="Enter delivery address">


        <button class="btn"
                onclick="scheduleDelivery()">

            Schedule Delivery

        </button>

    </div>

</section>


<!-- ORDER STATUS -->

<section class="section">

    <h2>
        Order Tracking
    </h2>

    <div class="order-section">

        <input
            type="text"
            id="orderId"
            placeholder="Enter Order ID">

        <button class="btn"
                onclick="checkOrder()">

            Check Order Status

        </button>

        <p id="orderStatus"
           style="margin-top:20px;font-weight:bold;">
        </p>

    </div>

</section>


<!-- ADMIN -->

<section class="section">

    <h2>
        Admin Management
    </h2>

    <div class="admin-panel">


        <div class="admin-card">

            <h3>
                Customer Information
            </h3>

            <p>
                Edit, change or delete customer
                information.
            </p>

            <button class="btn"
                    onclick="customerInfo()">

                Manage Customers

            </button>

        </div>


        <div class="admin-card">

            <h3>
                Inventory
            </h3>

            <p>
                Add, change or delete products
                from inventory.
            </p>

            <button class="btn"
                    onclick="inventory()">

                Manage Inventory

            </button>

        </div>


        <div class="admin-card">

            <h3>
                Order Summary
            </h3>

            <p>
                View customer orders and
                order summary.
            </p>

            <button class="btn"
                    onclick="orderSummary()">

                View Orders

            </button>

        </div>


        <div class="admin-card">

            <h3>
                Email Support
            </h3>

            <p>
                Contact customers through
                email.
            </p>

            <button class="btn"
                    onclick="emailSupport()">

                Contact

            </button>

        </div>

    </div>

</section>


<!-- CART -->

<div class="cart"
     id="cart">

    <button class="close-cart"
            onclick="closeCart()">

        ×

    </button>

    <h2>
        Shopping Cart
    </h2>

    <div id="cartItems">
    </div>

    <div class="cart-total">

        Total: ₹
        <span id="cartTotal">
            0
        </span>

    </div>

    <button class="btn"
            style="width:100%;"
            onclick="checkout()">

        Checkout

    </button>

</div>


<!-- LOGIN -->

<div class="modal"
     id="loginModal">

    <div class="modal-content">

        <span class="close"
              onclick="closeLogin()">

            ×

        </span>

        <h2>
            Login
        </h2>

        <input
            type="email"
            id="email"
            placeholder="Email Address">

        <input
            type="password"
            id="password"
            placeholder="Password">

        <button class="btn"
                onclick="login()">

            Login

        </button>

        <p style="text-align:center;margin-top:15px;">

            New customer?

            <b onclick="register()"
               style="color:#8e2450;cursor:pointer;">

                Create Account

            </b>

        </p>

    </div>

</div>


<!-- FOOTER -->

<footer>

    <h3>
        BlossomGifts
    </h3>

    <p>
        Making every occasion special with
        beautiful flowers and thoughtful gifts.
    </p>

    <br>

    <p>
        © 2026 BlossomGifts. All Rights Reserved.
    </p>

</footer>


<script>


/* PRODUCT DATA */

const products = [

    {
        id: 1,
        name: "Red Rose Bouquet",
        category: "Flowers",
        price: 999,
        image:
        "https://images.unsplash.com/photo-1490750967868-88aa4486c946"
    },

    {
        id: 2,
        name: "Pink Flower Basket",
        category: "Flowers",
        price: 1299,
        image:
        "https://images.unsplash.com/photo-1526047932273-341f2a7631f9"
    },

    {
        id: 3,
        name: "Luxury Gift Basket",
        category: "Gift Baskets",
        price: 1999,
        image:
        "https://images.unsplash.com/photo-1513201099705-a9746e1e201f"
    },

    {
        id: 4,
        name: "Personalized Gift Box",
        category: "Personalized",
        price: 1499,
        image:
        "https://images.unsplash.com/photo-1549465220-1a8b9238cd48"
    },

    {
        id: 5,
        name: "Birthday Surprise Box",
        category: "Birthday",
        price: 1199,
        image:
        "https://images.unsplash.com/photo-1530103862676-de8c9debad1d"
    },

    {
        id: 6,
        name: "Anniversary Flower Set",
        category: "Anniversary",
        price: 1799,
        image:
        "https://images.unsplash.com/photo-1523438885200-e635ba2c371e"
    }

];


let cart = [];


/* DISPLAY PRODUCTS */

function displayProducts(list = products) {

    const productList =
        document.getElementById("productList");

    productList.innerHTML = "";


    if(list.length === 0) {

        productList.innerHTML =
            "<h3>No products found.</h3>";

        return;
    }


    list.forEach(product => {

        productList.innerHTML += `

            <div class="product">

                <img
                    src="${product.image}?auto=format&fit=crop&w=500&q=80"
                    alt="${product.name}">

                <div class="product-info">

                    <h3>
                        ${product.name}
                    </h3>

                    <p>
                        Category:
                        ${product.category}
                    </p>

                    <div class="price">
                        ₹${product.price}
                    </div>

                    <button
                        onclick="addToCart(${product.id})">

                        Add to Cart

                    </button>

                </div>

            </div>

        `;

    });

}


/* SEARCH */

function searchProducts() {

    const search =
        document
        .getElementById("search")
        .value
        .toLowerCase();


    const filtered =
        products.filter(product =>

            product.name
            .toLowerCase()
            .includes(search)

        );


    displayProducts(filtered);

}


/* FILTER */

function filterProducts() {

    const category =
        document
        .getElementById("categoryFilter")
        .value;


    if(category === "All") {

        displayProducts(products);

    }

    else {

        const filtered =
            products.filter(product =>
                product.category === category
            );

        displayProducts(filtered);

    }

}


/* CATEGORY */

function filterCategory(category) {

    document
    .getElementById("categoryFilter")
    .value = category;


    filterProducts();


    document
    .getElementById("products")
    .scrollIntoView();

}


/* CART */

function addToCart(id) {

    const product =
        products.find(
            p => p.id === id
        );


    cart.push(product);

    updateCart();


    alert(
        product.name +
        " added to cart!"
    );

}


function updateCart() {

    document
    .getElementById("cartCount")
    .innerText = cart.length;


    const cartItems =
        document
        .getElementById("cartItems");


    cartItems.innerHTML = "";


    let total = 0;


    cart.forEach((item, index) => {

        total += item.price;


        cartItems.innerHTML += `

            <div class="cart-item">

                <div>

                    <b>
                        ${item.name}
                    </b>

                    <br>

                    ₹${item.price}

                </div>

                <button
                    onclick="removeFromCart(${index})">

                    ❌

                </button>

            </div>

        `;

    });


    document
    .getElementById("cartTotal")
    .innerText = total;

}


function removeFromCart(index) {

    cart.splice(index, 1);

    updateCart();

}


function openCart() {

    document
    .getElementById("cart")
    .classList.add("active");

}


function closeCart() {

    document
    .getElementById("cart")
    .classList.remove("active");

}


/* CHECKOUT */

function checkout() {

    if(cart.length === 0) {

        alert(
            "Your shopping cart is empty!"
        );

        return;
    }


    alert(
        "Checkout successful!\n\n" +
        "Order confirmation will be sent " +
        "through Email/SMS."
    );


    cart = [];

    updateCart();

    closeCart();

}


/* DELIVERY */

function scheduleDelivery() {

    const name =
        document
        .getElementById("customerName")
        .value;


    const date =
        document
        .getElementById("deliveryDate")
        .value;


    const address =
        document
        .getElementById("address")
        .value;


    if(name === "" ||
       date === "" ||
       address === "") {

        alert(
            "Please enter all delivery details."
        );

        return;
    }


    alert(
        "Delivery scheduled successfully!\n\n" +
        "Customer: " + name +
        "\nDate: " + date +
        "\nAddress: " + address
    );

}


/* ORDER STATUS */

function checkOrder() {

    const orderId =
        document
        .getElementById("orderId")
        .value;


    if(orderId === "") {

        alert(
            "Please enter Order ID."
        );

        return;
    }


    document
    .getElementById("orderStatus")
    .innerText =
        "Order " +
        orderId +
        " is currently OUT FOR DELIVERY 🚚";

}


/* LOGIN */

function openLogin() {

    document
    .getElementById("loginModal")
    .style.display = "block";

}


function closeLogin() {

    document
    .getElementById("loginModal")
    .style.display = "none";

}


function login() {

    const email =
        document
        .getElementById("email")
        .value;


    const password =
        document
        .getElementById("password")
        .value;


    if(email === "" ||
       password === "") {

        alert(
            "Please enter email and password."
        );

        return;
    }


    alert(
        "Login successful!"
    );


    closeLogin();

}


function register() {

    alert(
        "Registration page opened."
    );

}


/* ADMIN FUNCTIONS */

function customerInfo() {

    alert(
        "Customer Management\n\n" +
        "✓ Add Customer\n" +
        "✓ Edit Customer\n" +
        "✓ Delete Customer\n" +
        "✓ View Customer Information"
    );

}


function inventory() {

    alert(
        "Inventory Management\n\n" +
        "✓ Add Product\n" +
        "✓ Change Product\n" +
        "✓ Delete Product\n" +
        "✓ Check Availability"
    );

}


function orderSummary() {

    alert(
        "Order Summary\n\n" +
        "Total Orders: 25\n" +
        "Pending Orders: 5\n" +
        "Delivered Orders: 20"
    );

}


function emailSupport() {

    window.location.href =
        "mailto:support@blossomgifts.com";

}


/* INITIAL LOAD */

displayProducts();

</script>

</body>
</html>
